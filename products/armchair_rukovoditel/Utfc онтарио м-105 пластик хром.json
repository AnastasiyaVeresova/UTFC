    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки спинки и сиденья кресла: искусственная кожа<br>\n- цвет материала - по каталогу"
            ],
            "components": [
                "спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Спинка</strong> состоит из основания, вкладыша пенополиуретанового и обивочного материала",
                "<strong>Сиденье</strong> состоит из основания, вкладыша пенополиуретанового и обивочного элемента",
                "Облицовка спинки и сиденья: искусственная кожа",
                "<strong>Подлокотники</strong> - пластиковые с мягкими накладками и вставками с имитацией под хром",
                "<strong>Механизм качания</strong> синхронный позволяет регулировать высоту сиденья, жесткость отклонения и фиксацию спинки в 3-х положениях",
                "<strong>Газ-лифт</strong> хромированный с высотой подъема 60 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> хромированное d=700 мм с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> черные d=60 мм с полиуретановым покрытием d=60 мм имеют узкий шток"
            ]
        }
    ],
