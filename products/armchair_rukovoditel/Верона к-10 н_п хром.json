  "construction_and_materials": [
    {
      "upholstery_materials": [
        "- материал облицовки спинки-сиденья и накладок подлокотников кресла:\nткань (Moderno), искусственная кожа (Z), экокожа (S,R), кожа (К)<br>\n- цвет материала - по каталогу"
      ],
      "components": [
        "металлических полозьев, спинки-сиденья, подлокотников, пластиковых заглушек, опор и крепежных элементов",
        "<strong>Полозья</strong> кресла сварные металлические с защитно-декоративным покрытием",
        "<strong>Каркас</strong> полозьев изготовлен из стальной трубы круглого сечения Ф32х2 мм, связи - из стального листа толщиной 3 мм. Покрытие полозьев: хромовое блестящее. На торцевые поверхности каркаса полозьев устанавливаются заглушки (2 шт.). На опорную поверхность каркаса полозьев устанавливаются опоры (4 шт.)",
        "<strong>Спинка-сиденье</strong> состоит из фанерного основания, мягкого элемента (пенополиуретан, жесткость - 32, плотность - 25 кг/м<sup>3</sup>) и облицовки",
        "<strong>Подлокотники</strong> - металлические «Айрон-хром» с мягкими накладками, крепятся к основанию спинки-сиденья с помощью винтов. Накладки состоят из фанерного основания, мягкого элемента (пенополиуретан, жесткость - 40, плотность - 22 кг/м<sup>3</sup>) и облицовки",
        "<strong>Материал</strong> облицовки спинки-сиденья и накладок подлокотников: ткань (Moderno), искусственная кожа (Z), экокожа (S,R), кожа (К)"
      ]
    }
  ],
